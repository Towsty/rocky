# Copy to .env (git-ignored) and fill in. Loaded by brain/config.py on start.
# Never commit real values.

# OpenRouter (default) or another OpenAI-compatible chat API.
# openrouter.ai/keys — without this, ask replies "Brain has no key" (no stack trace).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
MODEL=anthropic/claude-haiku-4.5

# fish.audio/app/api-keys — Rocky's voice (developer TTS API; top up API wallet, not website Plus)
FISH_AUDIO_API_KEY=
# Paid Fish model header: s1 | s2-pro | s2.1-pro (not s2.1-pro-free)
FISH_TTS_MODEL=s2-pro
# Rocky community / clone voice id
TTS_VOICE_ID=6dd07916890445e59c5f019ad0fc7879

# What Rocky calls you
HUMAN_NAME=

# Shared secret the robot must present when it connects (also in firmware/include/secrets.h)
ROBOT_TOKEN=

# Local mic when the robot is offline. MIC_SOURCE=mac means this computer (upstream naming).
# MIC_DEVICE: name substring (case-insensitive) or PortAudio index. Empty → Windows
# default communications input, else default input. Restart after changing.
# Examples after you see the startup device list:
#   MIC_SOURCE=mac
#   MIC_DEVICE=Headset Microphone
MIC_SOURCE=auto
MIC_DEVICE=

# Optional: where the two turn-detection models are cached on first run.
# Default is ~/.cache/desk-robot/ (the speech model goes to ~/.cache/huggingface/).
DESK_ROBOT_CACHE=

# Companion face window (http://127.0.0.1:8766/face). Default on; set 0 to skip auto-open.
OPEN_FACE=1
